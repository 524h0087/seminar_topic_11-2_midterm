{
  "info": {
    "name": "API Testing",
    "description": "Generated from the local Postman YAML workspace for Newman automation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Health Test",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}/actuator/health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"API status is UP\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"UP\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Authorization Test",
      "item": [
        {
          "name": "Invalid Test",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}/api/auth/login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"username\": \"admin\",\r\n    \"password\": \"demin321\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Invalid login returns 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test(\"Error message is correct\", function () {",
                  "    const json = pm.response.json();",
                  "",
                  "    pm.expect(json.detail).to.eql(",
                  "        \"Invalid username or password\"",
                  "    );",
                  "",
                  "    pm.test(\"Token is not created\", function () {",
                  "        pm.expect(pm.environment.get(\"token\")).to.be.undefined;",
                  "    });",
                  "",
                  "    pm.test(\"Token type is not created\", function () {",
                  "        pm.expect(pm.environment.get(\"tokenType\")).to.be.undefined;",
                  "    });",
                  "",
                  "    pm.test(\"Username is not created\", function () {",
                  "        pm.expect(pm.environment.get(\"username\")).to.be.undefined;",
                  "    });",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Clean up previous login data",
                  "pm.environment.unset(\"token\");",
                  "pm.environment.unset(\"tokenType\");",
                  "pm.environment.unset(\"username\");"
                ]
              }
            }
          ]
        },
        {
          "name": "Valid Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}/api/auth/login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"username\": \"admin\",\r\n    \"password\": \"admin123\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login returns 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Token exists\", function () {",
                  "    pm.expect(json.token).to.exist;",
                  "    pm.expect(json.token).to.be.a(\"string\");",
                  "});",
                  "",
                  "pm.test(\"Token type is Bearer\", function () {",
                  "    pm.expect(json.tokenType).to.eql(\"Bearer\");",
                  "});",
                  "",
                  "pm.test(\"Username is admin\", function () {",
                  "    pm.expect(json.username).to.eql(\"admin\");",
                  "});",
                  "",
                  "// Save JWT for subsequent requests",
                  "pm.environment.set(\"token\", json.token); ",
                  "pm.environment.set(\"tokenType\", json.tokenType); ",
                  "pm.environment.set(\"username\", json.username);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Clean up previous login data",
                  "pm.environment.unset(\"token\");",
                  "pm.environment.unset(\"tokenType\");",
                  "pm.environment.unset(\"username\");"
                ]
              }
            }
          ]
        }
      ]
    },
