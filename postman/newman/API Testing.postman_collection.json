                  "});",
                  "",
                  "pm.test(\"GPA is correct\", function () {",
                  "    pm.expect(json.gpa).to.eql(8.5);",
                  "});",
                  "",
                  "// Save the new ID for PUT/DELETE tests",
                  "pm.environment.set(\"studentId\", json.id);"
                ]
              }
            }
